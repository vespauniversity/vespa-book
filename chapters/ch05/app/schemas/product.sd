schema product {

  document product {

    # ESCI is multilingual. We index the US English subset, and telling Vespa
    # the language up front is what makes tokenisation and stemming correct.
    field locale type string {
      indexing: "en" | set_language
    }

    # The ASIN. Only unique within a locale, which is why the document id
    # carries the locale too. `rank: filter` because matching on an id should
    # never contribute to a relevance score.
    field id type string {
      indexing: summary | index
      rank: filter
      match: word
    }

    # `index` makes a field searchable; `attribute` makes it available in
    # memory for filtering, grouping and ranking. Fields the reader searches
    # get an index; fields used to rank or filter get an attribute.
    #
    # `enable-bm25` is what chapter 2's schema was missing: it tells Vespa to
    # keep the term statistics BM25 needs. Without it the feature exists but
    # always returns zero, which is the kind of failure that looks like bad
    # relevance rather than a missing setting.
    field title type string {
      indexing: summary | index
      index: enable-bm25
      match: text
    }

    # Bullet points, not description, are the body field here: 48.7% of this
    # corpus has no description at all (build.json, documents_without_description
    # 49,346 of 101,341); how many lack bullets is not counted, so no figure is
    # claimed. Ranking a field that is absent half the time looks like it works
    # and quietly scores nothing - which the untuned `default` profile
    # (`schemas/product/default.profile`) still does, deliberately: it is the
    # starting point chapter 3 tunes away from. An
    # array because that is how the bullets arrive once split.
    field bullets type array<string> {
      indexing: summary | index
      index: enable-bm25
      match: text
    }

    field description type string {
      indexing: summary | index
      index: enable-bm25
      match: text
    }

    field brand type string {
      indexing: summary | index | attribute
      index: enable-bm25
      match: text
    }

    field color type string {
      indexing: summary | index | attribute
      index: enable-bm25
      match: text
    }

    # Half the corpus has no description. Making its absence an explicit
    # signal is better than letting later ranking expressions score an empty
    # field and quietly conclude nothing.
    field has_description type bool {
      indexing: summary | attribute
    }

    # This is the field a reader fills from vectors computed outside Vespa.
    # It sits inside `document {}`, unlike
    # `title_embedding` below, because the feed supplies it directly rather
    # than Vespa deriving it from another field. Left empty at deploy time;
    # filled later by a partial update.
    field title_embedding_precomputed type tensor<float>(x[384]) {
      indexing: attribute
      attribute {
        distance-metric: prenormalized-angular
      }
    }

  }

  # BGE asks for a prefix on the query and nothing on the document, so nothing
  # is prepended here - the query side carries it. Other models want the
  # opposite: e5 marks both sides, MiniLM marks neither. Vespa applies none of
  # them, and using the wrong one produces no error and no warning, only worse
  # results. That is why the query side carries the prefix in one place
  # (`evaluate.QUERY_PREFIX`).
  field title_embedding type tensor<float>(x[384]) {
    indexing: input title | embed embedder | attribute | index
    attribute {
      distance-metric: prenormalized-angular
    }
    index {
      hnsw {
        max-links-per-node: 16
        neighbors-to-explore-at-insert: 200
      }
    }
  }

  # What a query searches when it does not name a field.
  fieldset default {
    fields: title, bullets, description, brand, color
  }

  document-summary context {
    # What a retrieval-augmented answer is built from. Three properties matter
    # and none of them is "all the text we have": the id, so a claim can be
    # traced back to a product; the title, so the answer can name it; and a
    # snippet of the description chosen around the query's own terms rather
    # than the whole description.
    #
    # `dynamic` is what makes the snippet query-dependent. Without it every
    # product contributes its whole description, the same text for every
    # query, which may say nothing about what the query asked for.
    summary id {}
    summary title {}
    summary snippet {
      source: description
      dynamic
    }
  }

  # A summary that returns only the id, for a caller that needs nothing else;
  # this chapter's tools select `id` in their YQL instead.
  document-summary minimal {
    summary id {}
  }

}
